# Single external RADIUS endpoint. Explicit per-service MikroTik-Realm.
server zradius {
 listen {
  type = auth
  ipaddr = *
  port = 1812
 }
 listen {
  type = acct
  ipaddr = *
  port = 1813
 }
 authorize {
  # ZRADIUS_PROXY_AUTHORIZE
  # ZRADIUS_EAP_AUTHORIZE
  if (&EAP-Message) {
   reject
  }
  if (&Mikrotik-Realm == "device-aaa") {
   if (!&User-Name || &User-Name !~ /^[a-zA-Z0-9_.-]{1,64}$/ || !&User-Password || &CHAP-Password || &EAP-Message || &MS-CHAP-Challenge) {
    reject
   }
   if (!&Service-Type || (&Service-Type != Login-User && &Service-Type != Administrative-User && &Service-Type != NAS-Prompt-User)) {
    reject
   }
   update control {
    Tmp-String-0 := "%{sql:SELECT CASE WHEN u.identity_id IS NULL THEN u.password_hash ELSE (SELECT c.password_hash FROM zradius_identity_credentials c WHERE c.identity_id=u.identity_id) END FROM zradius_device_users u JOIN zradius_device_effective_grants g ON g.user_id=u.id JOIN nas n ON n.id=g.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='device-aaa' WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND u.username='%{User-Name}' AND u.enabled AND ((u.identity_id IS NULL AND NOT EXISTS(SELECT 1 FROM zradius_identities i WHERE i.username=u.username)) OR EXISTS(SELECT 1 FROM zradius_identities i WHERE i.id=u.identity_id AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now())))}"
   }
   if (!&control:Tmp-String-0 || &control:Tmp-String-0 !~ /^[A-Za-z0-9+\/]{107}=$/) {
    reject
   }
   update control {
    Password-With-Header := "{ssha512}%{control:Tmp-String-0}"
   }
   pap
  }
  elsif (&Mikrotik-Realm == "hotspot" && &User-Name && &User-Name !~ /^hs-[a-f0-9]{20}$/) {
   if (&User-Name !~ /^[A-Za-z0-9_.-]{1,64}$/ || !&User-Password || &CHAP-Password || &EAP-Message || &MS-CHAP-Challenge || &MS-CHAP2-Response || &MS-CHAP-Response) {
    reject
   }
   update control {
    Tmp-String-0 := "%{sql:SELECT c.password_hash FROM zradius_identities i JOIN zradius_identity_credentials c ON c.identity_id=i.id JOIN zradius_identity_hotspot h ON h.identity_id=i.id JOIN nas n ON n.id=h.nas_id JOIN zradius_nas_services ns ON ns.nas_id=n.id AND ns.service_code='hotspot' WHERE i.username='%{User-Name}' AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now()) AND h.enabled AND n.type='mikrotik' AND n.nasname='%{Packet-Src-IP-Address}'}"
   }
   if (&control:Tmp-String-0 !~ /^[A-Za-z0-9+\/]{107}=$/) {
    reject
   }
   update control {
    Password-With-Header := "{ssha512}%{control:Tmp-String-0}"
   }
   pap
  }
  elsif (&Mikrotik-Realm == "hotspot") {
   if (!&User-Name || &User-Name !~ /^hs-[a-f0-9]{20}$/ || !&User-Password || &CHAP-Password || &EAP-Message || &MS-CHAP-Challenge) {
    reject
   }
   update control {
    Tmp-String-0 := "%{sql:SELECT v.password_hash FROM zradius_hotspot_vouchers v JOIN nas n ON n.id=v.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='hotspot' WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND v.username='%{User-Name}' AND v.enabled AND v.expires_at>now()}"
   }
   if (!&control:Tmp-String-0 || &control:Tmp-String-0 !~ /^[A-Za-z0-9+\/]{107}=$/) {
    reject
   }
   update control {
    Password-With-Header := "{ssha512}%{control:Tmp-String-0}"
   }
   pap
  }
  elsif (&Mikrotik-Realm == "ipoe") {
   if (!&User-Name || &User-Name !~ /^(?:[0-9A-Fa-f]{12}|[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}|[0-9A-Fa-f]{2}(-[0-9A-Fa-f]{2}){5})$/) {
    reject
   }
   if (&EAP-Message || &CHAP-Password || &MS-CHAP-Challenge) {
    reject
   }
   # Use actual packet source, never the claimed NAS-IP-Address.
   # The first runtime supports static IPv4 only; bindings requiring Option 82 fail closed.
   update control {
    Tmp-String-0 := "%{sql:SELECT host(b.static_ip) FROM zradius_ipoe_bindings b JOIN nas n ON n.id=b.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='ipoe' WHERE n.nasname='%{Packet-Src-IP-Address}' AND b.mac='%{User-Name}'::macaddr AND b.enabled AND b.static_ip IS NOT NULL AND b.circuit_id IS NULL AND b.remote_id IS NULL}"
   }
   if (&control:Tmp-String-0 !~ /^[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+$/) {
    reject
   }
   update reply {
    Framed-IP-Address := "%{control:Tmp-String-0}"
   }
   # MAC identity, not a reusable PPP password. Trust registered NAS and secured access edge.
   update control {
    Auth-Type := Accept
   }
  }
  elsif (&Mikrotik-Realm == "l2tp") {
   if (!&User-Name || &User-Name !~ /^[A-Za-z0-9_.@-]{1,64}$/ || !&Service-Type || &Service-Type != Framed-User || !&Framed-Protocol || &Framed-Protocol != PPP || &CHAP-Password) {
    reject
   }
   # Only PAP or MS-CHAPv2; no subscriber fallback.
   if (&User-Password && !&MS-CHAP-Challenge && !&MS-CHAP2-Response && !&MS-CHAP-Response) {
    update control {
     Tmp-String-0 := "%{sql:SELECT CASE WHEN u.identity_id IS NULL THEN u.password_hash ELSE (SELECT c.password_hash FROM zradius_identity_credentials c WHERE c.identity_id=u.identity_id) END FROM zradius_l2tp_users u JOIN zradius_l2tp_effective_profiles p ON p.user_id=u.id JOIN nas n ON n.id=u.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='l2tp' WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND u.username='%{User-Name}' AND u.enabled AND ((u.identity_id IS NULL AND NOT EXISTS(SELECT 1 FROM zradius_identities i WHERE i.username=u.username)) OR EXISTS(SELECT 1 FROM zradius_identities i WHERE i.id=u.identity_id AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now())))}"
    }
    if (&control:Tmp-String-0 !~ /^[A-Za-z0-9+\/]{107}=$/) {
     reject
    }
    update control {
     Password-With-Header := "{ssha512}%{control:Tmp-String-0}"
    }
    pap
   }
   elsif (!&User-Password && &MS-CHAP-Challenge && &MS-CHAP2-Response && !&MS-CHAP-Response) {
    update control {
     Tmp-String-0 := "%{sql:SELECT CASE WHEN u.identity_id IS NULL THEN u.nt_password ELSE (SELECT c.nt_password FROM zradius_identity_credentials c WHERE c.identity_id=u.identity_id) END FROM zradius_l2tp_users u JOIN zradius_l2tp_effective_profiles p ON p.user_id=u.id JOIN nas n ON n.id=u.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='l2tp' WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND u.username='%{User-Name}' AND u.enabled AND ((u.identity_id IS NULL AND NOT EXISTS(SELECT 1 FROM zradius_identities i WHERE i.username=u.username)) OR EXISTS(SELECT 1 FROM zradius_identities i WHERE i.id=u.identity_id AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now())))}"
    }
    if (&control:Tmp-String-0 !~ /^[0-9a-f]{32}$/) {
     reject
    }
    update control {
     NT-Password := "0x%{control:Tmp-String-0}"
    }
    mschap
   }
   else {
    reject
   }
  }
  elsif (&Mikrotik-Realm == "pppoe") {
   if (!&Service-Type || &Service-Type != Framed-User || !&Framed-Protocol || &Framed-Protocol != PPP) {
    reject
   }
   if (&User-Name =~ /^hs-[a-f0-9]{20}$/) {
    reject
   }
   update control {
    Tmp-String-2 := "%{sql:SELECT count(*) FROM nas n JOIN zradius_nas_services s ON s.nas_id=n.id WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND s.service_code='%{Mikrotik-Realm}'}"
   }
   if (&control:Tmp-String-2 != "1") {
    reject
   }
   filter_username
   if (&User-Name =~ /^[A-Za-z0-9_.-]{1,64}$/) {
    update control {
     Tmp-String-3 := "%{sql:SELECT count(*) FROM zradius_identities WHERE username='%{User-Name}'}"
    }
    if (&control:Tmp-String-3 !~ /^(0|1)$/) {
     reject
    }
   }
   else {
    update control {
     Tmp-String-3 := "0"
    }
   }
   if (&control:Tmp-String-3 == "1") {
    if (&User-Password && !&CHAP-Password && !&MS-CHAP-Challenge && !&MS-CHAP2-Response && !&MS-CHAP-Response) {
     update control {
      Tmp-String-0 := "%{sql:SELECT c.password_hash FROM zradius_identities i JOIN zradius_identity_credentials c ON c.identity_id=i.id JOIN zradius_identity_pppoe p ON p.identity_id=i.id JOIN nas n ON n.id=p.nas_id JOIN zradius_nas_services ns ON ns.nas_id=n.id AND ns.service_code='pppoe' WHERE i.username='%{User-Name}' AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now()) AND p.enabled AND n.type='mikrotik' AND n.nasname='%{Packet-Src-IP-Address}'}"
     }
     if (&control:Tmp-String-0 !~ /^[A-Za-z0-9+\/]{107}=$/) {
      reject
     }
     update control {
      Password-With-Header := "{ssha512}%{control:Tmp-String-0}"
     }
     pap
    }
    elsif (!&User-Password && !&CHAP-Password && &MS-CHAP-Challenge && &MS-CHAP2-Response && !&MS-CHAP-Response) {
     update control {
      Tmp-String-0 := "%{sql:SELECT c.nt_password FROM zradius_identities i JOIN zradius_identity_credentials c ON c.identity_id=i.id JOIN zradius_identity_pppoe p ON p.identity_id=i.id JOIN nas n ON n.id=p.nas_id JOIN zradius_nas_services ns ON ns.nas_id=n.id AND ns.service_code='pppoe' WHERE i.username='%{User-Name}' AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now()) AND p.enabled AND n.type='mikrotik' AND n.nasname='%{Packet-Src-IP-Address}'}"
     }
     if (&control:Tmp-String-0 !~ /^[0-9a-f]{32}$/) {
      reject
     }
     update control {
      NT-Password := "0x%{control:Tmp-String-0}"
     }
     mschap
    }
    else {
     reject
    }
   }
   else {
    preprocess
    chap
    mschap
    sql
    pap
   }
  }
  elsif (&Packet-Src-IP-Address == 127.0.0.1 && !&Mikrotik-Realm) {
   # Local development smoke tests only; no external fallback.
   if (&User-Name =~ /^[A-Za-z0-9_.-]{1,64}$/) {
    update control {
     Tmp-String-3 := "%{sql:SELECT count(*) FROM zradius_identities WHERE username='%{User-Name}'}"
    }
    if (&control:Tmp-String-3 != "0") {
     reject
    }
   }
   if (&Service-Type == Login-User || &Service-Type == Administrative-User || &Service-Type == NAS-Prompt-User || &Service-Type == Authenticate-Only || &User-Name =~ /^hs-[a-f0-9]{20}$/) {
    reject
   }
   filter_username
   preprocess
   chap
   mschap
   sql
   pap
  }
  else {
   reject
  }
 }
 authenticate {
  # ZRADIUS_EAP_AUTHENTICATE
  Auth-Type PAP {
   pap
  }
  Auth-Type CHAP {
   chap
  }
  Auth-Type MS-CHAP {
   mschap
  }
 }
 preacct {
  # ZRADIUS_PROXY_ACCOUNTING
  preprocess
  acct_unique
 }
 accounting {
  # Legacy local accounting and explicitly allowed registered NAS service only.
  if (&Packet-Src-IP-Address != 127.0.0.1 || &Mikrotik-Realm) {
   if (!&Mikrotik-Realm || &Mikrotik-Realm !~ /^(pppoe|l2tp|ipoe|hotspot|device-aaa)$/) {
    reject
   }
   if (!&NAS-IP-Address || &NAS-IP-Address != &Packet-Src-IP-Address) {
    reject
   }
   update control {
    Tmp-String-2 := "%{sql:SELECT count(*) FROM nas n JOIN zradius_nas_services s ON s.nas_id=n.id WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND s.service_code='%{Mikrotik-Realm}'}"
   }
   if (&control:Tmp-String-2 != "1") {
    reject
   }
  }
  sql
  if (&Mikrotik-Realm =~ /^(l2tp|pppoe|hotspot|ipoe|device-aaa)$/ && (&Acct-Status-Type == Start || &Acct-Status-Type == Interim-Update || &Acct-Status-Type == Stop)) {
   if (&Acct-Unique-Session-Id && &Acct-Unique-Session-Id =~ /^[0-9a-fA-F]{32}$/) {
    update control {
     Tmp-String-3 := "%{sql:UPDATE radacct SET zradius_service='%{Mikrotik-Realm}' WHERE acctuniqueid='%{Acct-Unique-Session-Id}' AND nasipaddress='%{Packet-Src-IP-Address}'::inet AND zradius_service IS NULL}"
    }
   }
  }
 }
 session {
  sql
 }
 post-auth {
  if (&Mikrotik-Realm == "device-aaa") {
   update control {
    Tmp-String-0 := "%{sql:SELECT g.role || ':' || COALESCE(g.filter_id,'') FROM zradius_device_users u JOIN zradius_device_effective_grants g ON g.user_id=u.id JOIN nas n ON n.id=g.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='device-aaa' WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND u.username='%{User-Name}' AND u.enabled AND ((u.identity_id IS NULL AND NOT EXISTS(SELECT 1 FROM zradius_identities i WHERE i.username=u.username)) OR EXISTS(SELECT 1 FROM zradius_identities i WHERE i.id=u.identity_id AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now())))}"
   }
   if (&control:Tmp-String-0 =~ /^([A-Za-z0-9_.-]{1,64}):([A-Za-z0-9_.-]{0,64})$/) {
    update reply {
     Mikrotik-Group := "%{1}"
    }
    update control {
     Tmp-String-3 := "%{2}"
    }
   }
   else {
    reject
   }
   if (&control:Tmp-String-3 != "") {
    update reply {
     Filter-Id := "%{control:Tmp-String-3}"
    }
   }
   update control {
    Tmp-String-1 := "%{sql:INSERT INTO zradius_device_auth_log(username,source_ip,result) VALUES ('%{User-Name}','%{Packet-Src-IP-Address}','accept')}"
   }
  }
  elsif (&Mikrotik-Realm == "hotspot" && &User-Name && &User-Name !~ /^hs-[a-f0-9]{20}$/) {
   if (&User-Name !~ /^[A-Za-z0-9_.-]{1,64}$/) {
    reject
   }
   update control {
    Tmp-String-0 := "%{sql:SELECT h.rate_limit || ':' || h.session_seconds || ':' || h.idle_seconds FROM zradius_identities i JOIN zradius_identity_credentials c ON c.identity_id=i.id JOIN zradius_identity_hotspot h ON h.identity_id=i.id JOIN nas n ON n.id=h.nas_id JOIN zradius_nas_services ns ON ns.nas_id=n.id AND ns.service_code='hotspot' WHERE i.username='%{User-Name}' AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now()) AND h.enabled AND n.type='mikrotik' AND n.nasname='%{Packet-Src-IP-Address}'}"
   }
   if (&control:Tmp-String-0 =~ /^([1-9][0-9]{0,5}M\/[1-9][0-9]{0,5}M):([0-9]{2,5}):([0-9]{2,5})$/) {
    update reply {
     Mikrotik-Rate-Limit := "%{1}"
     Session-Timeout := "%{2}"
     Idle-Timeout := "%{3}"
    }
   }
   else {
    reject
   }
  }
  elsif (&Mikrotik-Realm == "hotspot") {
   update control {
    Tmp-String-0 := "%{sql:SELECT LEAST(v.session_seconds,FLOOR(EXTRACT(EPOCH FROM v.expires_at-now())))::integer FROM zradius_hotspot_vouchers v JOIN nas n ON n.id=v.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='hotspot' WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND v.username='%{User-Name}' AND v.enabled AND v.expires_at>now()}"
   }
   if (&control:Tmp-String-0 !~ /^[1-9][0-9]*$/) {
    reject
   }
   update reply {
    Session-Timeout := "%{control:Tmp-String-0}"
    Idle-Timeout := "%{sql:SELECT idle_seconds FROM zradius_hotspot_vouchers WHERE username='%{User-Name}'}"
   }
   update control {
    Tmp-String-1 := "%{sql:SELECT COALESCE(rate_limit,'') FROM zradius_hotspot_vouchers WHERE username='%{User-Name}'}"
   }
   if (&control:Tmp-String-1 =~ /^[0-9]+M\/[0-9]+M$/) {
    update reply {
     Mikrotik-Rate-Limit := "%{control:Tmp-String-1}"
    }
   }
  }
  elsif (&Mikrotik-Realm == "l2tp") {
   update control {
    Tmp-String-0 := "%{sql:SELECT p.name || ':' || COALESCE(host(u.static_ip),'') || ':' || COALESCE(p.pool,'') || ':' || p.interim_seconds FROM zradius_l2tp_users u JOIN zradius_l2tp_effective_profiles p ON p.user_id=u.id JOIN nas n ON n.id=u.nas_id JOIN zradius_nas_services s ON s.nas_id=n.id AND s.service_code='l2tp' WHERE n.nasname='%{Packet-Src-IP-Address}' AND n.type='mikrotik' AND u.username='%{User-Name}' AND u.enabled AND ((u.identity_id IS NULL AND NOT EXISTS(SELECT 1 FROM zradius_identities i WHERE i.username=u.username)) OR EXISTS(SELECT 1 FROM zradius_identities i WHERE i.id=u.identity_id AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now())))}"
   }
   if (&control:Tmp-String-0 =~ /^([A-Za-z0-9_.-]{1,64}):([0-9.]{0,15}):([A-Za-z0-9_.-]{0,64}):([0-9]{2,5})$/) {
    update reply {
     Mikrotik-Group := "%{1}"
     Acct-Interim-Interval := "%{4}"
    }
    update control {
     Tmp-String-1 := "%{2}"
     Tmp-String-2 := "%{3}"
    }
    if (&control:Tmp-String-1 != "") {
     update reply {
      Framed-IP-Address := "%{control:Tmp-String-1}"
     }
    }
    elsif (&control:Tmp-String-2 != "") {
     update reply {
      Framed-Pool := "%{control:Tmp-String-2}"
     }
    }
    else {
     reject
    }
   }
   else {
    reject
   }
  }
  elsif (&Mikrotik-Realm == "pppoe" && &control:Tmp-String-3 == "1") {
   update control {
    Tmp-String-0 := "%{sql:SELECT p.rate_limit || ':' || p.pool || ':' || p.interim_seconds FROM zradius_identities i JOIN zradius_identity_credentials c ON c.identity_id=i.id JOIN zradius_identity_pppoe p ON p.identity_id=i.id JOIN nas n ON n.id=p.nas_id JOIN zradius_nas_services ns ON ns.nas_id=n.id AND ns.service_code='pppoe' WHERE i.username='%{User-Name}' AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now()) AND p.enabled AND n.type='mikrotik' AND n.nasname='%{Packet-Src-IP-Address}'}"
   }
   if (&control:Tmp-String-0 =~ /^([1-9][0-9]{0,5}M\/[1-9][0-9]{0,5}M):([A-Za-z0-9_.-]{1,64}):([0-9]{2,5})$/) {
    update reply {
     Mikrotik-Rate-Limit := "%{1}"
     Framed-Pool := "%{2}"
     Acct-Interim-Interval := "%{3}"
    }
   }
   else {
    reject
   }
  }
  elsif (&Mikrotik-Realm == "pppoe" || (&Packet-Src-IP-Address == 127.0.0.1 && !&Mikrotik-Realm)) {
   # ZRADIUS_POOL_POLICY
   noop
  }
  Post-Auth-Type REJECT {
   if (&Mikrotik-Realm == "device-aaa") {
    if (&User-Name && &User-Name =~ /^[a-zA-Z0-9_.-]{1,64}$/) {
     update control {
      Tmp-String-1 := "%{sql:INSERT INTO zradius_device_auth_log(username,source_ip,result) VALUES ('%{User-Name}','%{Packet-Src-IP-Address}','reject')}"
     }
    }
   }
  }
 }
}
