server zradius {
 listen {
  type = auth
  ipaddr = *
  port = 1812
 }
 listen {
  type = acct
  ipaddr = *
  port = 1813
 }
 authorize {
  filter_username
  preprocess
  # Administrative login is denied until dedicated Device AAA policy is validated.
  if (&Service-Type == Login-User || &Service-Type == Administrative-User || &Service-Type == NAS-Prompt-User || &Service-Type == Authenticate-Only) {
   reject
  }
  chap
  mschap
  sql
  pap
 }
 authenticate {
  Auth-Type PAP {
   pap
  }
  Auth-Type CHAP {
   chap
  }
  Auth-Type MS-CHAP {
   mschap
  }
 }
 preacct {
  preprocess
  acct_unique
 }
 accounting {
  sql
 }
 session {
  sql
 }
}
