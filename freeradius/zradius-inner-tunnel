# No listen section: accessible only from EAP tunnel.
server zradius-inner-tunnel {
 authorize {
  if (!&User-Name || &User-Name !~ /^[a-zA-Z0-9_.-]{1,64}$/) {
   reject
  }
  if (!&outer.request:Packet-Src-IP-Address) {
   reject
  }
  update control {
   Tmp-String-1 := "%{sql:SELECT c.nt_password FROM zradius_identities i JOIN zradius_identity_credentials c ON c.identity_id=i.id JOIN zradius_identity_eap a ON a.identity_id=i.id JOIN nas n ON n.id=a.nas_id WHERE i.username='%{User-Name}' AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now()) AND NOT EXISTS(SELECT 1 FROM zradius_effective_policy_rules r WHERE r.enabled AND r.effect='DENY' AND (r.service IS NULL OR r.service=a.service_code) AND (r.nas_id IS NULL OR r.nas_id=n.id) AND (r.identity_id=i.id OR EXISTS(SELECT 1 FROM zradius_identity_group_members m WHERE m.identity_id=i.id AND m.group_id=r.group_id))) AND a.enabled AND c.nt_password IS NOT NULL AND n.nasname='%{outer.request:Packet-Src-IP-Address}' AND EXISTS (SELECT 1 FROM zradius_nas_services s WHERE s.nas_id=n.id AND s.service_code=a.service_code) AND (SELECT count(*) FROM zradius_nas_services s WHERE s.nas_id=n.id AND s.service_code IN ('dot1x','wpa-enterprise'))=1 UNION ALL SELECT u.nt_password FROM zradius_eap_users u JOIN zradius_eap_grants g ON g.username=u.username JOIN nas n ON n.id=g.nas_id WHERE u.username='%{User-Name}' AND u.enabled AND n.nasname='%{outer.request:Packet-Src-IP-Address}' AND EXISTS (SELECT 1 FROM zradius_nas_services s WHERE s.nas_id=n.id AND s.service_code IN ('dot1x','wpa-enterprise')) AND NOT EXISTS (SELECT 1 FROM zradius_identities i WHERE i.username=u.username)}"
  }
  if (&control:Tmp-String-1 !~ /^[0-9a-f]{32}$/) {
   reject
  }
  update control {
   NT-Password := "0x%{control:Tmp-String-1}"
  }
  mschap
  eap
 }
 authenticate {
  Auth-Type MS-CHAP {
   mschap
  }
  Auth-Type EAP {
   eap
  }
 }
 post-auth {
  update control {
   Tmp-String-0 := "%{sql:SELECT COALESCE(a.vlan_id::text,'0') FROM zradius_identities i JOIN zradius_identity_credentials c ON c.identity_id=i.id JOIN zradius_identity_eap a ON a.identity_id=i.id JOIN nas n ON n.id=a.nas_id WHERE i.username='%{User-Name}' AND i.enabled AND (i.account_expires_at IS NULL OR i.account_expires_at>now()) AND NOT EXISTS(SELECT 1 FROM zradius_effective_policy_rules r WHERE r.enabled AND r.effect='DENY' AND (r.service IS NULL OR r.service=a.service_code) AND (r.nas_id IS NULL OR r.nas_id=n.id) AND (r.identity_id=i.id OR EXISTS(SELECT 1 FROM zradius_identity_group_members m WHERE m.identity_id=i.id AND m.group_id=r.group_id))) AND a.enabled AND c.nt_password IS NOT NULL AND n.nasname='%{outer.request:Packet-Src-IP-Address}' AND EXISTS (SELECT 1 FROM zradius_nas_services s WHERE s.nas_id=n.id AND s.service_code=a.service_code) AND (SELECT count(*) FROM zradius_nas_services s WHERE s.nas_id=n.id AND s.service_code IN ('dot1x','wpa-enterprise'))=1 UNION ALL SELECT COALESCE(u.vlan_id::text,'0') FROM zradius_eap_users u JOIN zradius_eap_grants g ON g.username=u.username JOIN nas n ON n.id=g.nas_id WHERE u.username='%{User-Name}' AND u.enabled AND n.nasname='%{outer.request:Packet-Src-IP-Address}' AND EXISTS (SELECT 1 FROM zradius_nas_services s WHERE s.nas_id=n.id AND s.service_code IN ('dot1x','wpa-enterprise')) AND NOT EXISTS (SELECT 1 FROM zradius_identities i WHERE i.username=u.username)}"
  }
  if (&control:Tmp-String-0 !~ /^[0-9]+$/) {
   reject
  }
  if (&control:Tmp-String-0 != "0") {
   update reply {
    Tunnel-Type := VLAN
    Tunnel-Medium-Type := IEEE-802
    Tunnel-Private-Group-Id := "%{control:Tmp-String-0}"
   }
  }
 }
}
