POSTGRES_PASSWORD=replace_with_random_hex
ADMIN_TOKEN=replace_with_at_least_32_random_characters
RADIUS_TEST_SECRET=replace_with_random_hex

# Enable only on a trusted management network.
RADIUS_ENABLE_NAS=false
RADIUS_BIND_IP=127.0.0.1
COA_ENABLED=false
COA_ALLOWED_NETWORKS=

# Experimental SQL IP pool; isolated lab only.
RADIUS_ENABLE_SQLIPPOOL=false
