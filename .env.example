POSTGRES_PASSWORD=replace_with_random_hex
ADMIN_TOKEN=replace_with_at_least_32_random_characters
RADIUS_TEST_SECRET=replace_with_random_hex

# Enable only on a trusted management network.
RADIUS_ENABLE_NAS=false
RADIUS_BIND_IP=127.0.0.1
COA_ENABLED=false
COA_ALLOWED_NETWORKS=

# Experimental SQL IP pool; isolated lab only.
RADIUS_ENABLE_SQLIPPOOL=false

# EAP overlay requires externally issued certificates.
RADIUS_PKI_DIR=./pki



# Independent credentials; generate each with openssl rand -hex 32.
ZRADIUS_API_DB_PASSWORD=replace_with_random_hex
ZRADIUS_RUNTIME_DB_PASSWORD=replace_with_random_hex

# AES-256 key: openssl rand -hex 32; keep offline backup, do not regenerate.
ZRADIUS_SECRET_KEY=replace_with_random_hex

# Transitional legacy token access is disabled by default.
ZRADIUS_LEGACY_TOKEN_ENABLED=false

# Optional LDAPS replicas: explicit primary-to-replica map, same AD domain only.
# ZRADIUS_LDAP_FAILOVER_MAP='{"dc01.corp.local":["dc02.corp.local"]}'
